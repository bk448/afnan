# Supabase — destination for /contact/book/ consultation requests.
#
# Copy this file to .env.local and fill both values from your Supabase project
# under Project Settings -> API. Restart `npm run dev` afterwards.
#
# BOTH VALUES ARE PUBLIC. They are compiled into the browser bundle and are not
# secrets. The actual protection is Row Level Security, defined in
# supabase/migrations/20261124130000_booking_requests.sql, which grants the anon role
# INSERT and nothing else.
#
# NEVER put the service_role key in a VITE_ variable. It bypasses RLS and would
# expose every submitted booking to anyone who views the page source.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
