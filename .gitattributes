# Normalise line endings: LF in the repository, native in the working copy.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary assets - never normalise, never diff as text
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp4   binary
*.webm  binary

# SVG is text, but diffs are noise
*.svg   text eol=lf linguist-detectable=false

# Lockfiles: keep in repo, collapse in diffs/PR review
package-lock.json  -diff linguist-generated=true
yarn.lock          -diff linguist-generated=true
pnpm-lock.yaml     -diff linguist-generated=true
